NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Outbound email: invoices, receipts, overdue reminders, registration notices
# and the scholarship-failure alert. sendEmail() refuses with a readable error
# when HOST/USER/PASS are missing rather than pretending to send, so leaving
# these blank is safe locally — but nothing will go out.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Default From. SMTP_FROM_ACCOUNTS overrides it for anything about money, so a
# student replying to an invoice reaches accounts rather than support.
SMTP_FROM=
SMTP_FROM_ACCOUNTS=

# Only needed to run `npm run test:e2e` (scripts/e2e-test.js) — a real,
# active Super Admin login in this Supabase project. Never commit real values.
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

# Not set locally. In production this closes the cron routes
# (/api/cron/*): without it a plain run is allowed and only the dry run,
# which names students, is refused. See src/lib/cronAuth.ts.
CRON_SECRET=

# Optional. The absolute origin used for links that leave the app — the
# "View receipt" button in invoice emails and the student link in the
# registration notice. Falls back to Vercel's production domain, so it only
# needs setting when that is not the domain you want in emails.
NEXT_PUBLIC_SITE_URL=
