NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Outbound email: invoices, receipts, overdue reminders, registration notices
# and the scholarship-failure alert. sendEmail() refuses with a readable error
# when HOST/USER/PASS are missing rather than pretending to send, so leaving
# these blank is safe locally — but nothing will go out.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Default From. SMTP_FROM_ACCOUNTS overrides it for anything about money, so a
# student replying to an invoice reaches accounts rather than support.
SMTP_FROM=
SMTP_FROM_ACCOUNTS=

# Only needed to run `npm run test:e2e` (scripts/e2e-test.js) — a real,
# active Super Admin login in this Supabase project. Never commit real values.
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

# Not set locally. In production this closes the cron routes
# (/api/cron/*): without it a plain run is allowed and only the dry run,
# which names students, is refused. See src/lib/cronAuth.ts.
CRON_SECRET=

# Optional. The absolute origin used for links that leave the app — the
# "View receipt" button in invoice emails and the student link in the
# registration notice. Falls back to Vercel's production domain, so it only
# needs setting when that is not the domain you want in emails.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Social Media module (docs/SOCIAL_SETUP.md). Tokens are encrypted in Postgres
# with the existing Vault key (credential_encryption_key) — no key lives here.
# Left blank, the module runs in SANDBOX mode: connecting creates test accounts
# and nothing is sent to a real platform, so the whole module is usable before
# the apps are approved. Set SOCIAL_LIVE=yes only once the apps below are live.
SOCIAL_LIVE=
# Facebook and Instagram share ONE Meta app.
META_APP_ID=
META_APP_SECRET=
# Threads has its OWN app id/secret (from the Threads use case → Settings),
# distinct from the Meta app above. If left blank it falls back to the Meta app,
# but threads.net rejects the Meta app id, so set these for live Threads.
THREADS_APP_ID=
THREADS_APP_SECRET=
# LinkedIn (Community Management / Posts API).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok (Content Posting API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Snapchat (Public Profile API).
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
