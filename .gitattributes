# Shell scripts must keep LF endings whatever core.autocrlf says locally.
#
# This machine has core.autocrlf=true, which would check .githooks/pre-commit
# out with CRLF. A shell script whose shebang ends "#!/bin/sh\r" fails on Linux
# and macOS with "bad interpreter: no such file or directory" — a message that
# points at the interpreter rather than at the invisible carriage return, so it
# costs real time to diagnose.
.githooks/* text eol=lf
*.sh text eol=lf
