{
  "name": "hmarkstudentportal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-test.js",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/*-test.mjs",
    "test": "npm run test:unit",
    "check:agreement": "node scripts/verify-agreement-flow.mjs",
    "check:invoice": "node scripts/verify-invoice-flow.mjs",
    "check:pay": "node scripts/verify-pay-split.mjs",
    "check:roles": "node scripts/verify-multi-role.mjs",
    "check:speed": "node scripts/check-speed.mjs",
    "check:studentid": "node scripts/verify-student-id.mjs",
    "check:catalogue": "node scripts/verify-catalogue-import.mjs",
    "check:hook": "sh scripts/verify-hook.sh",
    "check:xlsx": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-xlsx-in-excel.ps1",
    "prepare": "node scripts/install-hooks.mjs",
    "check:buttons": "node scripts/verify-button-widths.mjs",
    "check:staffcreds": "node scripts/verify-staff-credentials.mjs",
    "check:staffagreements": "node scripts/verify-staff-agreements.mjs",
    "check:leave": "node scripts/verify-leave.mjs",
    "check:pageaccess": "node scripts/verify-page-access.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@react-pdf/renderer": "^4.8.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.2",
    "next": "16.3.5",
    "node-html-parser": "^9.0.2",
    "nodemailer": "^9.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
